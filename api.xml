<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="ParaBank API regression" configfailurepolicy="continue" parallel="none">
  <listeners>
    <listener class-name="utilities.ExecutionTimingListener"/>
    <listener class-name="utilities.ExtentReportManager"/>
  </listeners>
  <test name="Core banking API">
    <classes>
      <class name="testclasses.api.ApiOpenApiContractTest"/>
      <class name="testclasses.api.CustomerApiTest"/>
      <class name="testclasses.api.AccountsApiTest"/>
      <class name="testclasses.api.MoneyMovementApiTest"/>
      <class name="testclasses.api.BillPayApiTest"/>
      <class name="testclasses.api.TransactionsApiTest"/>
      <class name="testclasses.api.LoansApiTest"/>
      <class name="testclasses.api.BankingJourneyApiTest"/>
      <class name="testclasses.api.ProductionRulesApiTest"/>
    </classes>
  </test>
  <test name="API infrastructure unit tests">
    <classes>
      <class name="testclasses.api.ApiInfrastructureTest"/>
    </classes>
  </test>
</suite>
