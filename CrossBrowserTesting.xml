<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="ParaBank cross-browser banking validation" parallel="tests" thread-count="3" configfailurepolicy="continue">
  <listeners>
    <listener class-name="utilities.ExecutionTimingListener"/>
    <listener class-name="utilities.ExtentReportManager"/>
  </listeners>

  <test name="Chrome">
    <parameter name="browser" value="chrome"/>
    <groups>
      <run>
        <include name="Sanity"/>
        <include name="BankingSmoke"/>
        <include name="BankingCompatibility"/>
        <include name="BankingAccess"/>
      </run>
    </groups>
    <classes>
      <class name="TestClases.RegistrationTest"/>
      <class name="TestClases.LoginTest"/>
      <class name="TestClases.LogoutTest"/>
      <class name="TestClases.AccountsOverviewTest"/>
      <class name="TestClases.TransferFundsTest"/>
      <class name="TestClases.BillPayTest"/>
      <class name="TestClases.OpenAccountTest"/>
      <class name="TestClases.FindTransactionsTest"/>
      <class name="TestClases.UpdateContactInfoTest"/>
      <class name="TestClases.RequestLoanTest"/>
      <class name="TestClases.CustomerLookupTest"/>
      <class name="TestClases.AccountDetailsTest"/>
      <class name="TestClases.BankingAccessTest">
        <methods>
          <include name="testBrowserBackAfterLogoutDoesNotExposeAccountData"/>
        </methods>
      </class>
    </classes>
  </test>

  <test name="Edge">
    <parameter name="browser" value="edge"/>
    <groups>
      <run>
        <include name="Sanity"/>
        <include name="BankingSmoke"/>
        <include name="BankingCompatibility"/>
        <include name="BankingAccess"/>
      </run>
    </groups>
    <classes>
      <class name="TestClases.RegistrationTest"/>
      <class name="TestClases.LoginTest"/>
      <class name="TestClases.LogoutTest"/>
      <class name="TestClases.AccountsOverviewTest"/>
      <class name="TestClases.TransferFundsTest"/>
      <class name="TestClases.BillPayTest"/>
      <class name="TestClases.OpenAccountTest"/>
      <class name="TestClases.FindTransactionsTest"/>
      <class name="TestClases.UpdateContactInfoTest"/>
      <class name="TestClases.RequestLoanTest"/>
      <class name="TestClases.CustomerLookupTest"/>
      <class name="TestClases.AccountDetailsTest"/>
      <class name="TestClases.BankingAccessTest">
        <methods>
          <include name="testBrowserBackAfterLogoutDoesNotExposeAccountData"/>
        </methods>
      </class>
    </classes>
  </test>

  <test name="Firefox">
    <parameter name="browser" value="firefox"/>
    <groups>
      <run>
        <include name="Sanity"/>
        <include name="BankingSmoke"/>
        <include name="BankingCompatibility"/>
        <include name="BankingAccess"/>
      </run>
    </groups>
    <classes>
      <class name="TestClases.RegistrationTest"/>
      <class name="TestClases.LoginTest"/>
      <class name="TestClases.LogoutTest"/>
      <class name="TestClases.AccountsOverviewTest"/>
      <class name="TestClases.TransferFundsTest"/>
      <class name="TestClases.BillPayTest"/>
      <class name="TestClases.OpenAccountTest"/>
      <class name="TestClases.FindTransactionsTest"/>
      <class name="TestClases.UpdateContactInfoTest"/>
      <class name="TestClases.RequestLoanTest"/>
      <class name="TestClases.CustomerLookupTest"/>
      <class name="TestClases.AccountDetailsTest"/>
      <class name="TestClases.BankingAccessTest">
        <methods>
          <include name="testBrowserBackAfterLogoutDoesNotExposeAccountData"/>
        </methods>
      </class>
    </classes>
  </test>
</suite>
