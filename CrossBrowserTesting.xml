<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="ParaBank cross-browser banking validation" parallel="tests" thread-count="3" configfailurepolicy="continue">
  <listeners>
    <listener class-name="utilities.ExecutionTimingListener"/>
    <listener class-name="utilities.ExtentReportManager"/>
  </listeners>

  <test name="Chrome">
    <parameter name="browser" value="chrome"/>
    <groups>
      <run>
        <include name="Sanity"/>
        <include name="BankingSmoke"/>
        <include name="BankingCompatibility"/>
        <include name="BankingAccess"/>
      </run>
    </groups>
    <classes>
      <class name="testclasses.RegistrationTest"/>
      <class name="testclasses.LoginTest"/>
      <class name="testclasses.LogoutTest"/>
      <class name="testclasses.AccountsOverviewTest"/>
      <class name="testclasses.TransferFundsTest"/>
      <class name="testclasses.BillPayTest"/>
      <class name="testclasses.OpenAccountTest"/>
      <class name="testclasses.FindTransactionsTest"/>
      <class name="testclasses.UpdateContactInfoTest"/>
      <class name="testclasses.RequestLoanTest"/>
      <class name="testclasses.CustomerLookupTest"/>
      <class name="testclasses.AccountDetailsTest"/>
      <class name="testclasses.BankingAccessTest">
        <methods>
          <include name="testBrowserBackAfterLogoutDoesNotExposeAccountData"/>
        </methods>
      </class>
    </classes>
  </test>

  <test name="Edge">
    <parameter name="browser" value="edge"/>
    <groups>
      <run>
        <include name="Sanity"/>
        <include name="BankingSmoke"/>
        <include name="BankingCompatibility"/>
        <include name="BankingAccess"/>
      </run>
    </groups>
    <classes>
      <class name="testclasses.RegistrationTest"/>
      <class name="testclasses.LoginTest"/>
      <class name="testclasses.LogoutTest"/>
      <class name="testclasses.AccountsOverviewTest"/>
      <class name="testclasses.TransferFundsTest"/>
      <class name="testclasses.BillPayTest"/>
      <class name="testclasses.OpenAccountTest"/>
      <class name="testclasses.FindTransactionsTest"/>
      <class name="testclasses.UpdateContactInfoTest"/>
      <class name="testclasses.RequestLoanTest"/>
      <class name="testclasses.CustomerLookupTest"/>
      <class name="testclasses.AccountDetailsTest"/>
      <class name="testclasses.BankingAccessTest">
        <methods>
          <include name="testBrowserBackAfterLogoutDoesNotExposeAccountData"/>
        </methods>
      </class>
    </classes>
  </test>

  <test name="Firefox">
    <parameter name="browser" value="firefox"/>
    <groups>
      <run>
        <include name="Sanity"/>
        <include name="BankingSmoke"/>
        <include name="BankingCompatibility"/>
        <include name="BankingAccess"/>
      </run>
    </groups>
    <classes>
      <class name="testclasses.RegistrationTest"/>
      <class name="testclasses.LoginTest"/>
      <class name="testclasses.LogoutTest"/>
      <class name="testclasses.AccountsOverviewTest"/>
      <class name="testclasses.TransferFundsTest"/>
      <class name="testclasses.BillPayTest"/>
      <class name="testclasses.OpenAccountTest"/>
      <class name="testclasses.FindTransactionsTest"/>
      <class name="testclasses.UpdateContactInfoTest"/>
      <class name="testclasses.RequestLoanTest"/>
      <class name="testclasses.CustomerLookupTest"/>
      <class name="testclasses.AccountDetailsTest"/>
      <class name="testclasses.BankingAccessTest">
        <methods>
          <include name="testBrowserBackAfterLogoutDoesNotExposeAccountData"/>
        </methods>
      </class>
    </classes>
  </test>
</suite>
