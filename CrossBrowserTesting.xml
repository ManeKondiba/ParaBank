<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="ParaBank cross-browser smoke" parallel="tests" thread-count="3" configfailurepolicy="continue">
  <listeners>
    <listener class-name="utilities.ExtentReportManager"/>
  </listeners>

  <test name="Chrome">
    <parameter name="browser" value="chrome"/>
    <groups>
      <run>
        <include name="Sanity"/>
        <include name="BankingSmoke"/>
      </run>
    </groups>
    <classes>
      <class name="TestClases.RegistrationTest"/>
      <class name="TestClases.LoginTest"/>
      <class name="TestClases.LogoutTest"/>
      <class name="TestClases.AccountsOverviewTest"/>
      <class name="TestClases.TransferFundsTest"/>
      <class name="TestClases.BillPayTest"/>
    </classes>
  </test>

  <test name="Edge">
    <parameter name="browser" value="edge"/>
    <groups>
      <run>
        <include name="Sanity"/>
        <include name="BankingSmoke"/>
      </run>
    </groups>
    <classes>
      <class name="TestClases.RegistrationTest"/>
      <class name="TestClases.LoginTest"/>
      <class name="TestClases.LogoutTest"/>
      <class name="TestClases.AccountsOverviewTest"/>
      <class name="TestClases.TransferFundsTest"/>
      <class name="TestClases.BillPayTest"/>
    </classes>
  </test>

  <test name="Firefox">
    <parameter name="browser" value="firefox"/>
    <groups>
      <run>
        <include name="Sanity"/>
        <include name="BankingSmoke"/>
      </run>
    </groups>
    <classes>
      <class name="TestClases.RegistrationTest"/>
      <class name="TestClases.LoginTest"/>
      <class name="TestClases.LogoutTest"/>
      <class name="TestClases.AccountsOverviewTest"/>
      <class name="TestClases.TransferFundsTest"/>
      <class name="TestClases.BillPayTest"/>
    </classes>
  </test>
</suite>
