<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="ParaBank Security Suite" configfailurepolicy="continue" parallel="none">
  <listeners>
    <listener class-name="utilities.ExecutionTimingListener"/>
    <listener class-name="utilities.ExtentReportManager"/>
    <listener class-name="utilities.SmartRetryListener"/>
  </listeners>
  <test name="OWASP Security Validations">
    <groups>
      <run>
        <include name="Security"/>
      </run>
    </groups>
    <classes>
      <class name="testclasses.security.SecurityHeadersTest"/>
      <class name="testclasses.security.BrokenAccessControlTest"/>
      <class name="testclasses.security.SqlInjectionNegativeTest"/>
    </classes>
  </test>
</suite>
