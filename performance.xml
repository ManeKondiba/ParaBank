<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="ParaBank Performance Suite" configfailurepolicy="continue" parallel="none">
  <listeners>
    <listener class-name="utilities.ExecutionTimingListener"/>
    <listener class-name="utilities.ExtentReportManager"/>
    <listener class-name="utilities.SmartRetryListener"/>
  </listeners>
  <test name="API SLA &amp; Latency Benchmarks">
    <groups>
      <run>
        <include name="Performance"/>
      </run>
    </groups>
    <classes>
      <class name="testclasses.performance.ApiSlaTest"/>
    </classes>
  </test>
</suite>
