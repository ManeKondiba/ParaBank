/target/
/.apt_generated/
/.apt_generated_tests/
/.maven-cache/
/.jenkins-results/
/test-output/
/Reports/
/screenshots/*
!/screenshots/.gitkeep
/logs/
/.idea/
*.iml
/.vscode/
/config.local.properties
/.env
/se-metadata.json

# Local Eclipse metadata; Maven uses pom.xml.
/.classpath
/.project
/.settings/

# Local archives and application patches are maintained outside this framework.
/.local-backup/
/patches/PB-UI-001-overview-authentication.patch

# Keep only the root README and platform documentation in Git; other Markdown stays local.
*.[mM][dD]
!/README.md
!/SEMANTIC_CODE_MAP.md
!/.github/pull_request_template.md
!/.github/ai/*.[mM][dD]
