<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="ParaBank UI regression" configfailurepolicy="continue">
  <listeners>
    <listener class-name="utilities.ExecutionTimingListener"/>
    <listener class-name="utilities.ExtentReportManager"/>
    <listener class-name="utilities.SmartRetryListener"/>
  </listeners>

  <test name="Registration">
    <classes>
      <class name="testclasses.RegistrationTest"/>
    </classes>
  </test>
  <test name="Login">
    <classes>
      <class name="testclasses.LoginTest"/>
      <class name="testclasses.LoginDDTtest"/>
    </classes>
  </test>
  <test name="Logout">
    <classes>
      <class name="testclasses.LogoutTest"/>
    </classes>
  </test>
  <test name="Open account">
    <classes>
      <class name="testclasses.OpenAccountTest"/>
    </classes>
  </test>
  <test name="Accounts overview">
    <classes>
      <class name="testclasses.AccountsOverviewTest"/>
    </classes>
  </test>
  <test name="Account activity and transaction details">
    <classes>
      <class name="testclasses.AccountDetailsTest"/>
    </classes>
  </test>
  <test name="Transfer funds">
    <classes>
      <class name="testclasses.TransferFundsTest"/>
    </classes>
  </test>
  <test name="Bill pay">
    <classes>
      <class name="testclasses.BillPayTest"/>
    </classes>
  </test>
  <test name="Find transactions">
    <classes>
      <class name="testclasses.FindTransactionsTest"/>
    </classes>
  </test>
  <test name="Update contact information">
    <classes>
      <class name="testclasses.UpdateContactInfoTest"/>
    </classes>
  </test>
  <test name="Request loan">
    <classes>
      <class name="testclasses.RequestLoanTest"/>
    </classes>
  </test>
  <test name="Customer lookup">
    <classes>
      <class name="testclasses.CustomerLookupTest"/>
    </classes>
  </test>
  <test name="Banking access controls">
    <classes><class name="testclasses.BankingAccessTest"/></classes>
  </test>
  <test name="Banking accessibility">
    <classes><class name="testclasses.BankingAccessibilityTest"/></classes>
  </test>
  <test name="Utility unit tests">
    <groups>
      <run>
        <include name="Unit"/>
      </run>
    </groups>
    <classes>
      <class name="testclasses.UtilityUnitTest"/>
      <class name="testclasses.api.ApiInfrastructureTest"/>
    </classes>
  </test>
</suite>
